#!/usr/bin/env sh
# mb - dev loop and release tool for Mossbound (the GitHub Pages game).
#
# Modelled on PlastomePixels's ppx and LowPingNews's lpn. Builds are picked by the version inside,
# never by filename. A build arrives as a git commit on top of the code it was made from and is then
# merged, so git itself keeps every change made here and stops at any clash before a file is touched.
#
# One thing differs from ppx, and it matters: Mossbound's tests drive a real Chrome (tests/e2e), and
# two of them need live Nostr/MQTT relays. A phone cannot run that, and neither can the sandbox the
# builds come from. So `mb check` type-checks and builds -- the whole of what is checkable here -- and
# the e2e suite is a gate in GitHub Actions ahead of the publish. A failing test stops the deploy.
set -u

REPO="${MB_REPO:-$HOME/mossbound}"
# Termux's share handler writes to ~/downloads; the browser writes to ~/storage/downloads.
# Scan both or builds silently go missing.
DLS="${MB_DOWNLOADS:-$HOME/downloads $HOME/storage/downloads}"
NAME="Mossbound"
WORKFLOW="deploy.yml"
SYNCED="refs/mb/synced"       # the commit of the last build synced in
FORCE="${MB_FORCE:-}"

die() { printf '%s\n' "mb: $*" >&2; exit 1; }
say() { printf '  %s\n' "$*"; }
g() { git -C "$REPO" "$@"; }

# scratch folders, all under one parent that goes on exit. Call tmpdir directly, never in $( ).
TOP=""
trap '[ -z "$TOP" ] || rm -rf "$TOP"' EXIT
tmpdir() {
  if [ -z "$TOP" ]; then TOP="$(mktemp -d 2>/dev/null || mktemp -d -t mb)" || die "no temporary folder"; fi
  MKT="$TOP/$1"; rm -rf "$MKT"; mkdir -p "$MKT" || die "no temporary folder"
}

# Top-level paths this project owns. Nothing else is ever extracted, committed or released.
OWNED="src tests public .github index.html package.json package-lock.json tsconfig.json vite.config.ts README.md LICENSE .gitignore mb"
owned() { for o in $OWNED; do [ "$1" = "$o" ] && return 0; done; return 1; }
# files every complete build has
CORE="package.json package-lock.json index.html vite.config.ts tsconfig.json src/main.ts src/app.ts src/game/session.ts src/game/levels.ts tests/e2e/run.mjs .github/workflows/deploy.yml mb README.md .gitignore"

# ---- versions ------------------------------------------------------------------------------

ver_text() { sed -n 's/^[[:space:]]*"version"[[:space:]]*:[[:space:]]*"\([0-9][0-9.]*\)".*$/\1/p' | head -n 1; }
repo_ver() { [ -f "$REPO/package.json" ] && ver_text < "$REPO/package.json"; }
member()   { tar tzf "$1" 2>/dev/null | grep -xF -e "$2" -e "./$2" | head -n 1; }   # its name in the archive
tar_ver()  { _tv_m="$(member "$1" package.json)"; [ -n "$_tv_m" ] && tar xzf "$1" -O "$_tv_m" 2>/dev/null | ver_text; }

newer() {   # newer A B: is version A later than B? (1.10.0 > 1.9.0; no sort -V needed)
  awk -v a="$1" -v b="$2" 'BEGIN {
    n = split(a, x, "."); m = split(b, y, "."); k = n > m ? n : m
    for (i = 1; i <= k; i++) { d = (x[i] + 0) - (y[i] + 0); if (d > 0) exit 0; if (d < 0) exit 1 }
    exit 1 }'
}

valid_ver() { case "$1" in ""|.*|*.|*..*|*[!0-9.]*) return 1 ;; esac; return 0; }

# the wire protocol peers check before they will play together (src/net/protocol.ts)
proto_ver() { sed -n 's/^export const PROTOCOL = \([0-9][0-9]*\);.*$/\1/p' "$REPO/src/net/protocol.ts" 2>/dev/null | head -n 1; }

# ---- archives -------------------------------------------------------------------------------

# 0 a complete build of this project; 1 holds something else (foreign files, links, devices, paths that
# climb out or into .git); 2 not a whole archive; 3 only part of a build
archive_ok() {
  _ao_list="$(tar tzf "$1" 2>/dev/null)" || return 2
  [ -n "$_ao_list" ] || return 2
  tar tzvf "$1" 2>/dev/null | grep -q '^[^-d]' && return 1      # only plain files and folders
  printf '%s\n' "$_ao_list" | {
    while IFS= read -r m; do
      [ "$m" = "./" ] && continue
      m="${m#./}"
      case "$m" in
        ""|/*|*//*|.|./*|*/.|*/./*|..|../*|*/..|*/../*|.git|.git/*|*/.git|*/.git/*) exit 1 ;;
        .mb-base) continue ;;                  # the commit the build was made from (read, never kept)
      esac
      owned "${m%%/*}" || exit 1
    done
    exit 0
  } || return 1
  for _ao_f in $CORE; do printf '%s\n' "$_ao_list" | grep -qxF -e "$_ao_f" -e "./$_ao_f" || return 3; done
  return 0
}

# the newest complete build in the download folders, by the version inside: "path version"
newest_archive() {
  best=""; bv=""
  for d in $DLS; do
    [ -d "$d" ] || continue
    for t in "$d"/mossbound-v*.tar.gz "$d"/mossbound-v*.tgz; do
      [ -f "$t" ] || continue
      archive_ok "$t"; ok=$?
      case $ok in
        1) say "skipping $(basename "$t"): holds links, devices or files this project does not own" >&2; continue ;;
        2) say "skipping $(basename "$t"): not a whole archive (download cut short?)" >&2; continue ;;
        3) say "skipping $(basename "$t"): only part of a build" >&2; continue ;;
      esac
      v="$(tar_ver "$t")"
      valid_ver "$v" || { say "skipping $(basename "$t"): no version inside" >&2; continue; }
      # between two archives of the same version, the newer download
      if [ -z "$best" ] || newer "$v" "$bv" || { [ "$v" = "$bv" ] && [ "$t" -nt "$best" ]; }; then best="$t"; bv="$v"; fi
    done
  done
  [ -n "$best" ] && printf '%s %s\n' "$best" "$bv"
}

# ---- GitHub ---------------------------------------------------------------------------------

repo_slug() {
  [ -n "${MB_GH_REPO:-}" ] && { printf '%s\n' "$MB_GH_REPO"; return; }
  g remote get-url origin 2>/dev/null | sed -n 's#.*github\.com[:/]\([^/]*/[^/]*\)$#\1#p' | sed 's#\.git$##'
}

site_url() {
  slug="$(repo_slug)"
  [ -n "$slug" ] || return 1
  owner="$(printf '%s' "${slug%%/*}" | tr '[:upper:]' '[:lower:]')"
  printf 'https://%s.github.io/%s/\n' "$owner" "${slug#*/}"
}

gh_t() {   # gh, but a weak signal cannot hold mb for long
  if command -v timeout >/dev/null 2>&1; then timeout 25 gh "$@"; else gh "$@"; fi
}

need_gh() { command -v gh >/dev/null 2>&1 || die "needs gh (pkg install gh), signed in: gh auth login"; }

# GitHub's tag vVERSION (its object id), empty if there is none; fails when GitHub can't be reached
remote_tag() { _rt="$(g ls-remote --tags origin "refs/tags/v$1")" || return 1; printf '%s\n' "$_rt" | awk 'NR == 1 { print $1 }'; }
local_tag()  { g rev-parse -q --verify "refs/tags/v$1" 2>/dev/null; }
clean_tree() { [ -z "$(g status --porcelain 2>/dev/null)" ]; }

pages_on() {   # Pages built by the workflow, not from a branch (409 = already on)
  slug="$(repo_slug)"
  gh_t api -X POST "repos/$slug/pages" -f build_type=workflow >/dev/null 2>&1 \
    || gh_t api -X PUT "repos/$slug/pages" -f build_type=workflow >/dev/null 2>&1 \
    || say "(could not switch Pages on - Settings > Pages > Source: GitHub Actions)"
}

# what the live site serves, and how its last publish went
site_status() {
  url="$(site_url)" || { say "site       no GitHub remote"; return 0; }
  live=""
  if command -v curl >/dev/null 2>&1; then
    live="$(curl -fsS --max-time 15 "${url}version.json" 2>/dev/null | sed -n 's/.*"version" *: *"\([0-9.]*\)".*/\1/p')"
  fi
  rv="$(repo_ver)"
  if [ -n "$live" ]; then
    if [ "$live" = "$rv" ]; then say "site       v$live live   $url"
    else say "site       v$live live, repo has v$rv   $url"; fi
  else
    say "site       not answering (yet?)   $url"
  fi
  command -v gh >/dev/null 2>&1 || return 0
  slug="$(repo_slug)"
  run="$(gh_t run list -R "$slug" --workflow "$WORKFLOW" -L 1 --json status,conclusion,createdAt,databaseId \
    --jq '.[0] | select(.) | [.status, (.conclusion // ""), (((now - (.createdAt | fromdateiso8601)) / 60) | floor | tostring), (.databaseId | tostring)] | join(" ")' 2>/dev/null)" \
    || { say "           (could not read the publish runs: gh auth status)"; return 0; }
  [ -n "$run" ] || { say "           no publish runs yet: mb web"; return 0; }
  set -- $run
  st="$1"; concl="${2:-}"; mins="${3:-0}"; id="${4:-}"
  [ "$st" = completed ] || { concl=""; mins="${2:-0}"; id="${3:-}"; }
  case "$mins" in ""|*[!0-9]*) mins=0 ;; esac
  if [ "$mins" -lt 60 ]; then ago="${mins}m"; elif [ "$mins" -lt 1440 ]; then ago="$((mins / 60))h"; else ago="$((mins / 1440))d"; fi
  case "$st:$concl" in
    completed:success) say "           last publish ${ago} ago: ok (tests passed)" ;;
    completed:cancelled) say "           last publish ${ago} ago was replaced by a newer one" ;;
    completed:*) say "           last publish ${ago} ago FAILED - why: gh run view $id -R $slug --log-failed" ;;
    *) say "           building now (started ${ago} ago) - the e2e suite runs before it publishes" ;;
  esac
}

# ---- commands -------------------------------------------------------------------------------

cmd_status() {
  rv="$(repo_ver)"
  p="$(proto_ver)"
  say "repo       ${rv:-none}${p:+   wire protocol $p}   $REPO"
  a="$(newest_archive 2>/dev/null || true)"
  if [ -n "$a" ]; then
    av="${a##* }"
    note=""
    [ -n "$rv" ] && newer "$av" "$rv" && note="   newer: mb sync"
    say "download   $av   ${a% *}$note"
  else
    say "download   none"
  fi
  if [ -d "$REPO/.git" ]; then
    [ "${MB_NOFETCH:-}" = "1" ] || g fetch -q origin 2>/dev/null || true
    lh="$(g rev-parse --short HEAD 2>/dev/null || printf '?')"
    rh="$(g rev-parse --short '@{u}' 2>/dev/null || printf '?')"
    dirty=""; clean_tree || dirty=" (unsaved changes: mb ship \"...\")"
    say "git        $lh local / $rh remote$dirty"
    site_status
  else
    say "git        not a repository: git clone it first"
  fi
  return 0
}

install_self() {   # the mb on your PATH follows the repo's copy
  [ -f "$REPO/mb" ] || return 0
  me="$(command -v mb 2>/dev/null || true)"
  [ -n "$me" ] && [ -f "$me" ] || return 0
  [ "$(cd "$(dirname "$me")" && pwd)" = "$(cd "$REPO" && pwd)" ] && return 0
  [ "$(cksum < "$REPO/mb")" = "$(cksum < "$me")" ] && return 0
  sh -n "$REPO/mb" 2>/dev/null || { say "(the repo's mb does not check out: not installed)"; return 0; }
  cp "$REPO/mb" "$me.new" && chmod +x "$me.new" && mv "$me.new" "$me" && say "updated the mb command"
}

cmd_sync() {
  command -v git >/dev/null 2>&1 || die "needs git (pkg install git)"
  a="$(newest_archive)" || true
  [ -n "$a" ] || die "no complete $NAME build (mossbound-v*.tar.gz) in: $DLS"
  t="${a% *}"; v="${a##* }"
  tmpdir build; b="$MKT"
  tar xzf "$t" -C "$b" || die "could not unpack $t"
  base=""
  if [ -f "$b/.mb-base" ]; then base="$(head -n 1 "$b/.mb-base" | tr -cd '0-9a-f')"; rm -f "$b/.mb-base"; fi
  tree=""
  if [ -d "$REPO/.git" ] && g rev-parse -q --verify HEAD >/dev/null; then
    # the build's files as a git tree (only git's object store is written to)
    rm -f "$TOP/index"
    (cd "$b" && GIT_INDEX_FILE="$TOP/index" git --git-dir="$REPO/.git" --work-tree=. add -A -f .) \
      || die "could not read the build"
    tree="$(GIT_INDEX_FILE="$TOP/index" git --git-dir="$REPO/.git" write-tree)" || die "could not read the build"
    if [ "$tree" = "$(g rev-parse "HEAD^{tree}")" ] || [ "$tree" = "$(g rev-parse -q --verify "$SYNCED^{tree}" 2>/dev/null)" ]; then
      say "already synced: this v$v build is here"
      return 0
    fi
  fi
  cur="$(repo_ver || true)"
  if [ -f "$REPO/package.json" ] && ! valid_ver "$cur" && [ "$FORCE" != 1 ]; then
    die "cannot read the version in $REPO/package.json; MB_FORCE=1 mb sync takes $(basename "$t") anyway"
  fi
  if [ -n "$cur" ] && newer "$cur" "$v" && [ "$FORCE" != 1 ]; then
    die "refusing: $(basename "$t") is v$v, older than the repo's v$cur.
  Download the current build first, or set MB_FORCE=1 to go back."
  fi

  [ -d "$REPO/.git" ] || die "$REPO is not a git repository: git clone https://github.com/$(repo_slug 2>/dev/null || echo ATinyGreenCell/mossbound) \"$REPO\""
  [ -n "$tree" ] || die "the repository has no commits yet"

  # 1. unsaved changes are never touched: they must be shipped (or thrown away) first
  if ! clean_tree; then
    die "refusing: there are unsaved changes here:
$(g status --short | sed 's/^/    /')
  mb ship \"...\" keeps them (then sync again); git checkout -- . && git clean -fd throws them away."
  fi

  # 2. the build as a commit on top of the code it was made from
  if [ -n "$base" ]; then
    if ! g cat-file -e "$base^{commit}" 2>/dev/null; then
      g fetch -q origin 2>/dev/null || true
      g cat-file -e "$base^{commit}" 2>/dev/null \
        || die "refusing: this build was made from commit $(printf '%.7s' "$base"), which isn't here or on GitHub."
    fi
    parent="$base"
  else
    parent="$(g rev-parse HEAD)"
    synced="$(g rev-parse -q --verify "$SYNCED^{tree}" 2>/dev/null || true)"
    if [ -z "$synced" ] || [ "$synced" != "$(g rev-parse "HEAD^{tree}")" ]; then
      [ "$FORCE" = 1 ] || die "refusing: this build doesn't say what it was made from, and there is work here since the last sync.
  Ask for a build made from the code on GitHub (mb pack in a clone of it), or MB_FORCE=1 mb sync
  to take it anyway (your work stays in git history)."
      say "taking it over the work here, which stays in history: git checkout $(printf '%.7s' "$parent") -- <file> brings a file back"
    fi
  fi
  bc="$(g commit-tree "$tree" -p "$parent" -m "v$v build ($(basename "$t"))")" \
    || die "could not record the build (git config --global user.name / user.email?)"
  gone="$(g diff --name-only --diff-filter=D "$parent" "$bc" | grep -c . || true)"
  if [ "$gone" -gt 10 ] && [ "$FORCE" != 1 ]; then
    die "refusing: this build drops $gone files ($(g diff --name-only --diff-filter=D "$parent" "$bc" | head -n 3 | tr '\n' ' ')...).
  Is it a whole build? MB_FORCE=1 mb sync if this is right."
  fi

  # 3. merge it: git keeps the work done here and the build's changes, and stops at any clash
  if [ "$(g rev-parse HEAD)" = "$parent" ]; then
    g merge -q --ff-only "$bc" || die "updating the files stopped part way: git status shows where; git reset --hard undoes it"
  elif ! g merge -q --no-ff --no-edit -m "Merge the v$v build into the work done here" "$bc" >/dev/null 2>&1; then
    clash="$(g diff --name-only --diff-filter=U)"
    # both sides bumping the version is no clash: the build's is newer (checked above)
    if [ "$clash" = package.json ] && g checkout -q --theirs -- package.json 2>/dev/null \
       && g add package.json && g commit -q --no-edit >/dev/null 2>&1; then
      :
    else
      g merge --abort 2>/dev/null || g reset -q --merge 2>/dev/null
      hint="Ask for a build made from the code as it is on GitHub now."
      [ -z "$(g rev-list '@{u}..HEAD' 2>/dev/null)" ] || hint="Your latest commits aren't on GitHub yet, so no build can include them: mb ship, then ask for a new build."
      die "refusing: this build and work done here both changed:
$(printf '%s\n' "${clash:-(see git status)}" | sed 's/^/    /')
  Nothing was changed. $hint"
    fi
  fi
  g update-ref "$SYNCED" "$bc"
  say "synced v$v from $(basename "$t")"
  g diff --stat=72 "$parent" "$bc" 2>/dev/null | tail -n 1 | sed 's/^ */  /'
  install_self
}

# Type-check and build. Prints only on failure. Returns non-zero when anything fails.
#
# This is NOT the test suite. tests/e2e drives a real Chrome and two of its groups need live relays,
# which no phone can do -- that suite is a gate in GitHub Actions, ahead of the publish.
run_check() {
  [ -f "$REPO/package.json" ] || { say "no source in $REPO: mb sync first"; return 1; }
  sh -n "$REPO/mb" || { say "mb has a syntax error"; return 1; }
  for _t_f in $CORE; do [ -f "$REPO/$_t_f" ] || { say "missing $_t_f"; return 1; }; done
  _t_v="$(repo_ver)"; valid_ver "$_t_v" || { say "package.json has no version"; return 1; }
  if ! command -v node >/dev/null 2>&1 || ! command -v npm >/dev/null 2>&1; then
    say "node is not installed (pkg install nodejs-lts), so only the files were checked."
    say "GitHub type-checks, builds and runs the whole e2e suite before it publishes; a failure stops it."
    return 0
  fi
  tmpdir check; _t_log="$MKT/check.log"
  if ! (
    cd "$REPO" || exit 1
    # the build tools again only when the lockfile changed (an archive's file times can't be trusted)
    if [ "$(cat node_modules/.mb-lock 2>/dev/null)" != "$(cksum < package-lock.json)" ]; then
      echo "installing the build tools"; npm ci --no-audit --no-fund || exit 1
      cksum < package-lock.json > node_modules/.mb-lock
    fi
    npm run build
  ) > "$_t_log" 2>&1; then
    tail -n 30 "$_t_log"
    return 1
  fi
  _t_bv="$(sed -n 's/.*"version" *: *"\([0-9.]*\)".*/\1/p' "$REPO/dist/version.json" 2>/dev/null)"
  [ "$_t_bv" = "$_t_v" ] || { say "the build says v$_t_bv but package.json says v$_t_v"; return 1; }
  say "type-checked and built v$_t_v (the e2e suite runs on GitHub)"
}
cmd_check() { run_check || die "check failed"; }

stray_check() {
  stray="$( { g -c core.quotePath=false ls-files --others --exclude-standard
              g -c core.quotePath=false diff --name-only HEAD 2>/dev/null
              g -c core.quotePath=false diff --name-only --cached 2>/dev/null; } | LC_ALL=C sort -u |
            while IFS= read -r f; do owned "${f%%/*}" || printf ' %s' "$f"; done )"
  [ -z "$stray" ] || die "refusing to commit files this project does not own:$stray
  remove them, or add them to OWNED in mb if they belong here"
}

cmd_ship() {
  [ -d "$REPO/.git" ] || die "$REPO is not a git repository"
  [ $# -ge 1 ] || die 'usage: mb ship "what changed"'
  stray_check
  g add -A
  if g diff --cached --quiet; then
    # nothing new; but commits a failed push left behind still go out
    if g rev-parse -q --verify '@{u}' >/dev/null 2>&1 && [ -z "$(g rev-list '@{u}..HEAD' 2>/dev/null)" ]; then
      say "nothing to commit"; return 0
    fi
  else
    g commit -q -m "$*" || die "commit failed"
  fi
  g push -q -u origin HEAD || die "push failed - the commit is kept (GitHub has newer commits? mb pull first); mb ship again"
  say "pushed $(g rev-parse --short HEAD) - tests then publish in a few minutes (mb status)"
}

release_has_changes() {
  # the failure this prevents: a stale build synced, version bumped, released.
  last="$(g describe --tags --abbrev=0 2>/dev/null || true)"
  [ -n "$last" ] || return 0
  g diff --quiet "$last" -- . ':(exclude)package.json' 2>/dev/null || return 0
  [ -z "$(g status --porcelain --untracked-files=all -- . ':(exclude)package.json' 2>/dev/null)" ] || return 0
  old="$(g show "$last:package.json" 2>/dev/null | grep -v '"version"')"
  new="$(grep -v '"version"' "$REPO/package.json")"
  [ "$old" != "$new" ]
}

set_version() {
  f="$REPO/package.json"
  sed "s/^\([[:space:]]*\"version\"[[:space:]]*:[[:space:]]*\"\)[^\"]*\"/\1$1\"/" "$f" > "$f.new" && mv "$f.new" "$f"
  [ "$(repo_ver)" = "$1" ]
}

release_notes() { printf '%s\n\nPlay it at %s' "$1" "$(site_url 2>/dev/null || echo 'the GitHub Pages site')"; }

# push the branch and the tag, check GitHub has exactly this tag, then the GitHub release
finish_release() {   # finish_release VERSION NOTES-GIVEN-NOW DEFAULT-NOTES
  v="$1"; given="$2"; fallback="$3"
  g push -q -u origin HEAD || die "push failed - nothing is lost (GitHub has newer commits? mb pull first); run the same command again"
  g push -q origin "refs/tags/v$v" || die "pushing tag v$v failed - run the same command again"
  rt="$(remote_tag "$v")" || die "GitHub stopped answering before the tag could be checked - run the same command again"
  [ "$rt" = "$(local_tag "$v")" ] || die "GitHub's tag v$v is not this release's (git ls-remote --tags origin)"
  say "v$v is on GitHub"
  if command -v gh >/dev/null 2>&1; then
    slug="$(repo_slug)"
    # the notes kept in the tag, so a release finished later still gets them
    kept="$(g tag -l --format='%(contents:body)' "v$v" 2>/dev/null | sed '/^$/d')"
    if gh_t release view "v$v" -R "$slug" >/dev/null 2>&1; then
      if [ -n "$given" ]; then
        gh_t release edit "v$v" --notes "$(release_notes "$given")" -R "$slug" >/dev/null 2>&1 && say "release v$v notes updated"
      else
        say "release v$v was already made"
      fi
    elif gh_t release create "v$v" --title "$NAME v$v" --notes "$(release_notes "${given:-${kept:-$fallback}}")" -R "$slug" >/dev/null 2>&1; then
      say "release v$v created"
    else
      say "WARN: gh could not make the release (the tag is on GitHub; make the release on the web)"
    fi
  else
    say "gh is not installed - the tag is on GitHub; make the release on the web"
  fi
  say "released v$v - tests then publish in a few minutes (mb status)"
}

cmd_release() {
  [ $# -ge 1 ] || die 'usage: mb release <version> ["what changed"]'
  v="$1"; shift
  note="$*"
  valid_ver "$v" || die "version must be digits and dots, e.g. 1.4.0"
  [ -d "$REPO/.git" ] || die "$REPO is not a git repository"
  [ -n "$(repo_slug)" ] || die "no GitHub remote in $REPO"
  # GitHub decides what has been released: ask it first, before anything is pushed
  rt="$(remote_tag "$v")" || die "GitHub can't be reached right now; nothing was changed. Try again with a connection."
  lt="$(local_tag "$v")"
  if [ -n "$lt" ] && [ "$(g rev-parse "v$v^{commit}")" = "$(g rev-parse HEAD)" ] && clean_tree \
     && { [ -z "$rt" ] || [ "$rt" = "$lt" ]; }; then
    say "finishing v$v"                      # tagged here already, nothing new since: push what's missing
    finish_release "$v" "$note" "Two little sprouts, one vine."
    return 0
  fi
  [ -z "$rt" ] || die "v$v is already released, and things changed since.
  Release them as a new version: mb release <next version>"
  if [ -n "$lt" ]; then
    say "tag v$v never reached GitHub: it moves to this release"
  else
    release_has_changes || die "refusing: nothing changed since the last release apart from the version.
  A stale archive was probably synced. Download the current build and run mb sync."
  fi
  stray_check
  cur="$(repo_ver)"
  was="$(cat "$REPO/package.json")"
  if [ "$cur" != "$v" ]; then
    if newer "$cur" "$v" && [ "$FORCE" != "1" ]; then die "v$v is older than the current v$cur"; fi
    set_version "$v" || die "version bump failed"
    say "bumped $cur -> $v"
  fi
  if ! run_check; then
    printf '%s\n' "$was" > "$REPO/package.json"
    die "check failed - nothing was committed${cur:+ (the version is back at $cur)}"
  fi
  g add -A
  if g diff --cached --quiet; then
    # Nothing to commit because `mb sync` already brought the build in. Its commit is named after
    # the archive it came out of, which is true but is not what this project's history looks like,
    # so this release renames it. Only ever a commit that has not been pushed: once GitHub has it,
    # it is left exactly as it is.
    head_msg="$(g log -1 --format=%s 2>/dev/null)"
    case "$head_msg" in
      "v$v build ("*)
        if [ -n "$(g rev-list '@{u}..HEAD' 2>/dev/null)" ] || ! g rev-parse -q --verify '@{u}' >/dev/null 2>&1; then
          g commit -q --amend -m "$NAME $v${note:+: $note}" || die "could not name the release commit"
          say "named the build commit \"$NAME $v${note:+: $note}\""
        fi
        ;;
    esac
  else
    g commit -q -m "$NAME $v${note:+: $note}" || die "commit failed"
  fi
  if [ -n "$note" ]; then g tag -f -a "v$v" -m "$NAME v$v" -m "$note" >/dev/null || die "tag failed"
  else g tag -f -a "v$v" -m "$NAME v$v" >/dev/null || die "tag failed"; fi
  finish_release "$v" "$note" "Two little sprouts, one vine."
}

cmd_web() {
  need_gh
  slug="$(repo_slug)"
  [ -n "$slug" ] || die "no GitHub remote in $REPO"
  pages_on
  if gh_t workflow run "$WORKFLOW" -R "$slug" >/dev/null 2>&1; then say "build started"
  else say "(start it by hand: Actions > Deploy to GitHub Pages > Run workflow)"; fi
  say "in a few minutes: $(site_url)"
}

cmd_pull() {
  [ -d "$REPO/.git" ] || die "$REPO is not a git repository"
  g pull --ff-only || die "pull failed"
  install_self
}

cmd_clean() {   # old and broken archives go; complete builds newer than the repo (not synced yet) stay
  cur="$(repo_ver || true)"
  n=0
  for d in $DLS; do
    for f in "$d"/mossbound-v*.tar.gz "$d"/mossbound-v*.tgz; do
      [ -f "$f" ] || continue
      v="$(tar_ver "$f")"
      if archive_ok "$f" && valid_ver "$v" && { [ -z "$cur" ] || newer "$v" "$cur"; }; then
        say "kept $(basename "$f"): v$v is not synced yet"; continue
      fi
      rm -f "$f" && n=$((n + 1))          # synced already, or not a build mb would ever take
    done
  done
  say "removed $n old download(s)"
}

cmd_pack() {   # the archive mb sync takes: every file of the project that git would keep
  dest="${1:-}"
  if [ -z "$dest" ]; then for d in $DLS; do [ -d "$d" ] && { dest="$d"; break; }; done; fi
  [ -n "$dest" ] || dest="$HOME"
  [ -d "$dest" ] || die "no folder $dest"
  dest="$(cd "$dest" && pwd)" || die "cannot use $dest"
  root="$(cd "$REPO" && pwd)" || die "no project in $REPO"
  case "$dest/" in "$root/"*) die "put the archive outside the project folder (it would end up in the next commit)" ;; esac
  v="$(repo_ver)"; valid_ver "$v" || die "package.json has no version"
  tmpdir pack; tmp="$MKT"
  # a throwaway git index reads .gitignore exactly as a commit would
  git --git-dir="$tmp/g" init -q 2>/dev/null || die "git is needed"
  (cd "$root" && git -c core.excludesFile=/dev/null -c core.quotePath=false --git-dir="$tmp/g" --work-tree=. \
     ls-files --others --exclude-standard) > "$tmp/all" || die "listing failed"
  while IFS= read -r f; do owned "${f%%/*}" && printf '%s\n' "$f"; done < "$tmp/all" > "$tmp/list"
  for f in $CORE; do grep -qxF -- "$f" "$tmp/list" || die "the project is missing $f"; done
  # the commit the build is made from (what GitHub had), so mb sync can merge it into later work
  if [ -d "$root/.git" ]; then
    (cd "$root" && { git merge-base HEAD '@{u}' 2>/dev/null || git rev-parse -q --verify HEAD; }) > "$tmp/.mb-base" 2>/dev/null
    [ -s "$tmp/.mb-base" ] || rm -f "$tmp/.mb-base"
  fi
  out="$dest/mossbound-v$v.tar.gz"
  if [ -f "$tmp/.mb-base" ]; then tar czf "$out.new" -C "$root" -T "$tmp/list" -C "$tmp" .mb-base || die "tar failed"
  else tar czf "$out.new" -C "$root" -T "$tmp/list" || die "tar failed"; fi
  mv "$out.new" "$out" || die "cannot write $out"
  say "$(grep -c . "$tmp/list") files -> $out"
}

cmd_open() {
  url="$(site_url)" || die "no GitHub remote"
  if command -v termux-open-url >/dev/null 2>&1; then termux-open-url "$url"
  elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$url" >/dev/null 2>&1
  elif command -v open >/dev/null 2>&1; then open "$url"
  else printf '%s\n' "$url"; fi
}

usage() {
  cat <<'EOF'
mb - Mossbound: sync builds, check, publish on GitHub Pages

  mb status           repo / newest download / git, and what the live site serves
  mb sync             newest complete build (by the version inside) -> merged into the repo
  mb check            type-check and build (needs node: pkg install nodejs-lts)
  mb ship "msg"       commit and push; GitHub runs the e2e suite, then publishes
  mb release <ver> ["what changed"]
                      bump the version, check, commit, tag, push, GitHub release
  mb web              switch Pages on and start a build
  mb open             open the live game
  mb pull             git pull, then update this command
  mb pack [dir]       make mossbound-v<version>.tar.gz (what mb sync takes)
  mb clean            delete downloaded archives already synced
  mb version          the repo's version

The e2e suite drives a real Chrome and needs live relays, so it runs in GitHub Actions, not here.
A failing test stops the publish: mb status says how the last one went.

env: MB_REPO (default ~/mossbound)  MB_DOWNLOADS (space-separated dirs)
     MB_FORCE=1 (go back a version; take a build that can't be merged)  MB_NOFETCH=1  MB_GH_REPO=owner/name
EOF
}

c="${1:-}"
[ $# -gt 0 ] && shift
case "$c" in
  status)  cmd_status ;;
  sync)    cmd_sync ;;
  check)   cmd_check ;;
  ship)    cmd_ship "$@" ;;
  release) cmd_release "$@" ;;
  web)     cmd_web ;;
  open)    cmd_open ;;
  pull)    cmd_pull ;;
  clean)   cmd_clean ;;
  pack)    cmd_pack "$@" ;;
  version|--version|-V) v="$(repo_ver)"; printf '%s\n' "${v:-unknown}" ;;
  ""|-h|--help|help) usage ;;
  *) usage; exit 1 ;;
esac
